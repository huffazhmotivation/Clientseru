// Skema database — PostgreSQL + Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  DESIGNER
  CLIENT
}

enum RequestStatus {
  PENDING
  WORKING
  REVISION
  DONE
  CANCELLED
}

enum QuotaEntryType {
  TOPUP // penambahan kuota manual oleh admin
  USAGE // pemakaian karena request selesai
  ADJUST // koreksi / pengurangan manual
}

enum DeliverableType {
  FILE // file yang diupload ke server (mis. hasil export desain)
  LINK // link eksternal, mis. Google Drive / Figma
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String // hash bcrypt
  role         Role     @default(CLIENT)
  clientId     String? // diisi hanya untuk role CLIENT
  client       Client?  @relation("ClientLogin", fields: [clientId], references: [id], onDelete: Cascade)
  ownedClients  Client[]  @relation("ClientOwner") // client-client yang dipegang designer ini (hanya relevan untuk role DESIGNER)
  ownedPackages Package[] @relation("PackageOwner") // katalog paket milik designer ini (hanya relevan untuk role DESIGNER)
  sentInvitations ClientInvitation[] @relation("InvitationSender") // undangan client yang dibuat designer ini
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model Client {
  id         String   @id @default(cuid())
  name       String // nama PIC
  company    String
  email      String   @unique
  phone      String?
  active     Boolean  @default(true)
  note       String?
  packageId  String?
  package    Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  designerId String // designer pemilik client ini
  designer   User     @relation("ClientOwner", fields: [designerId], references: [id])
  createdAt  DateTime @default(now())

  users      User[]            @relation("ClientLogin")
  quota      ClientQuota?
  requests   DesignRequest[]
  history    QuotaHistory[]
  invitation ClientInvitation?

  @@index([designerId])
}

/**
 * Undangan aktivasi akun client. Dibuat saat designer menambahkan client baru
 * (menu Client → Tambah Client). Client membuka /invite/[token], membuat
 * password sendiri, lalu akun User (role CLIENT) dibuat dan token ditandai
 * terpakai (sekali pakai).
 */
model ClientInvitation {
  id         String    @id @default(cuid())
  token      String    @unique
  name       String // nama PIC saat undangan dibuat (disalin ke User setelah aktivasi)
  email      String
  clientId   String    @unique // satu client hanya punya satu undangan aktif/terpakai
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  designerId String // designer pengundang
  designer   User      @relation("InvitationSender", fields: [designerId], references: [id])
  usedAt     DateTime? // null = belum diaktivasi; terisi = token sudah terpakai, tidak bisa dipakai lagi
  createdAt  DateTime  @default(now())

  @@index([designerId])
  @@index([token])
}

model Package {
  id         String   @id @default(cuid())
  name       String
  quota      Int
  price      Int      @default(0)
  note       String?
  designerId String // tiap designer punya katalog paket sendiri
  designer   User     @relation("PackageOwner", fields: [designerId], references: [id])
  createdAt  DateTime @default(now())

  clients Client[]

  @@unique([designerId, name]) // nama paket unik per-designer, boleh sama antar designer beda
  @@index([designerId])
}

model ClientQuota {
  id          String   @id @default(cuid())
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  totalQuota  Int      @default(0)
  usedQuota   Int      @default(0)
  periodLabel String? // contoh: "September 2026"
  updatedAt   DateTime @updatedAt
}

model DesignRequest {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      RequestStatus @default(PENDING)
  quotaCost   Int           @default(1)
  quotaTaken  Boolean       @default(false) // penanda kuota sudah dipotong
  briefUrl    String?
  referenceUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  doneAt      DateTime?

  deliverables Deliverable[]

  @@index([clientId, status])
}

/** Hasil kerja designer untuk satu request: bisa file upload atau link (Google Drive, dll). */
model Deliverable {
  id          String          @id @default(cuid())
  requestId   String
  request     DesignRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type        DeliverableType
  url         String
  name        String // nama tampilan, mis. "Final_Banner_v2.png" atau "Folder Google Drive"
  createdAt   DateTime        @default(now())

  @@index([requestId])
}

model QuotaHistory {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        QuotaEntryType
  amount      Int // positif untuk TOPUP, negatif untuk USAGE/ADJUST
  description String
  requestId   String?
  createdAt   DateTime       @default(now())

  @@index([clientId, createdAt])
}

/**
 * Vercel serverless functions punya filesystem read-only & tidak permanen,
 * jadi file upload (brief, referensi, hasil kerja) TIDAK bisa ditulis ke disk.
 * File disimpan sebagai base64 di tabel ini dan disajikan lewat /api/files/[id],
 * supaya link-nya tetap URL biasa (bukan data: URL yang diblokir Chrome saat
 * dibuka di tab baru / target="_blank").
 */
model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  mime      String
  data      String // base64
  createdAt DateTime @default(now())
}
